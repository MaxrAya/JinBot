# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# API-ключ для Google Gemini
OPENAI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY_HERE

# Базовый URL API
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/

# Модели через запятую (по приоритету)
AI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-2.5-flash

# Telegram User ID админа (через запятую, опционально)
ADMIN_IDS=

# Прокси (опционально)
PROXY_URL=
